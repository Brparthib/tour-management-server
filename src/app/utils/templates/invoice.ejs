<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f6f8fa;
            margin: 0;
            padding: 0;
            color: #333;
        }
        .invoice-container {
            max-width: 600px;
            margin: 20px auto;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .invoice-header {
            background: #4f46e5;
            color: white;
            padding: 20px;
            text-align: center;
        }
        .invoice-header h1 {
            margin: 0;
            font-size: 24px;
        }
        .invoice-body {
            padding: 20px;
        }
        .invoice-details {
            width: 100%;
            border-collapse: collapse;
        }
        .invoice-details th, .invoice-details td {
            text-align: left;
            padding: 10px;
            border-bottom: 1px solid #eee;
        }
        .invoice-details th {
            background-color: #f3f4f6;
            color: #555;
            font-weight: bold;
        }
        .invoice-footer {
            padding: 15px 20px;
            background-color: #f3f4f6;
            text-align: center;
            font-size: 14px;
            color: #777;
        }
        .highlight {
            color: #000000;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <div class="invoice-header">
            <h1>Tour Booking Invoice</h1>
            <p>Transaction ID: <span class="highlight"><%= transactionId %></span></p>
        </div>
        <div class="invoice-body">
            <table class="invoice-details">
                <tr>
                    <th>Customer Name</th>
                    <td><%= userName %></td>
                </tr>
                <tr>
                    <th>Tour Title</th>
                    <td><%= tourTitle %></td>
                </tr>
                <tr>
                    <th>Booking Date</th>
                    <td><%= bookingDate %></td>
                </tr>
                <tr>
                    <th>Guest Count</th>
                    <td><%= guestCount %></td>
                </tr>
                <tr>
                    <th>Total Amount</th>
                    <td class="highlight">$<%= totalAmount %></td>
                </tr>
            </table>
        </div>
        <div class="invoice-footer">
            Thank you for booking with us! We look forward to your adventure.
        </div>
    </div>
</body>
</html>
